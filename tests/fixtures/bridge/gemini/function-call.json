{
  "contents": [
    {
      "role": "user",
      "parts": [
        {
          "text": "What is the weather in Tokyo?"
        }
      ]
    },
    {
      "role": "model",
      "parts": [
        {
          "text": "Let me check the weather."
        },
        {
          "functionCall": {
            "name": "get_weather",
            "args": {
